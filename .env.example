# Django
# Em produção use ENVIRONMENT=production: a app se recusa a subir com segredos
# padrão/curtos, DEBUG=True ou ALLOWED_HOSTS só de localhost.
ENVIRONMENT=development
DEBUG=True
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Origens confiáveis para CSRF (obrigatório em produção). Ex.: https://sme.municipio.gov.br
CSRF_TRUSTED_ORIGINS=
# SECURE_SSL_REDIRECT: herda de ENVIRONMENT; só defina (True/False) para forçar

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=escola_db
DB_USER=escola_user
DB_PASSWORD=escola_password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# S3/Storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Sentry
SENTRY_DSN=

LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Produção (docker-compose.prod.yml) — preencha antes do go-live
# ---------------------------------------------------------------------------
# ENVIRONMENT=production
# DEBUG=False
# ALLOWED_HOSTS=sme.municipio.gov.br
# CSRF_TRUSTED_ORIGINS=https://sme.municipio.gov.br
# CORS_ALLOWED_ORIGINS=https://sme.municipio.gov.br
# VITE_API_URL=https://sme.municipio.gov.br
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# nginx TLS: coloque fullchain.pem e privkey.pem em ./nginx/certs/
